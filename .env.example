# postgres://user:pass@host:5432/agriparts  |  pglite://memory  |  pglite://./.data/agriparts
DATABASE_URL=pglite://./.data/agriparts
PORT=3000
# Required in production: HMAC secret for MCP confirmation codes
AGRIPARTS_CONFIRM_SECRET=
AUTO_MIGRATE=true
SEED_DEMO=false
DISPATCHER_INTERVAL_MS=2000
LOG_LEVEL=info
# Pilot only, until the Xero OAuth connect flow exists
XERO_ACCESS_TOKEN=

# ---- Parts agent (Find a part) ----
# local (default): Claude through this computer's Claude Code sign-in, via the Claude Agent SDK. No API key.
#   Sign in once with the Claude Code CLI, or put a long-lived token from `claude setup-token` below.
# api: the Claude API with ANTHROPIC_API_KEY.   rules: offline matcher only.
PARTS_AGENT_ENGINE=local
PARTS_AGENT_MODEL=claude-opus-5-5
PARTS_AGENT_TIMEOUT_MS=150000
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
